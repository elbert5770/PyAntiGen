{
 "pyantigen_design": 4,
 "name": "flipflop",
 "factors": {
  "generator": {"truth": {"params": {"k_A_to_B": 0.35, "k_B_to_C": 0.07, "SF": 1.6}}},
  "treatment": {
   "Early": {"dose": 10, "delay": 5, "has_A_data": true},
   "Late": {"dose": 5, "delay": 10, "has_A_data": false}
  }
 },
 "subjects": {"Flipflop": {"kind": "cohort", "levels": {"generator": "truth"}}},
 "protocols": {
  "dose_at_delay": {
   "events": "Modules.Events:Example_event",
   "solver": "Modules.Solver_settings:solver_settings_Example",
   "observed": "Modules.Observed_species:all_species"
  }
 },
 "simulations": [
  {
   "all": {
    "subjects": ["Flipflop"],
    "protocol": "dose_at_delay",
    "factors": {"treatment": "*"}
   }
  }
 ],
 "assays": {
  "flipflop": {
   "observables": {
    "logB": {
     "model": {"expr": "predicted_B", "name": "log10(predicted_B)", "transform": "log10"},
     "data": {
      "file": "Flipflop.csv",
      "time": "time",
      "value": ["logB1", "logB2", "logB3"],
      "where": {"Treatment": "{treatment}"}
     },
     "noise": {"sigma": 0.05}
    },
    "logA": {
     "model": {"expr": "predicted_A", "name": "log10(predicted_A)", "transform": "log10"},
     "data": {
      "file": "Flipflop.csv",
      "time": "time",
      "value": "logA",
      "where": {"Treatment": "{treatment}"}
     },
     "noise": {"sigma": 0.75},
     "only": {"has_A_data": true}
    }
   }
  }
 }
}
