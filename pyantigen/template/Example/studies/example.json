{
 "pyantigen_design": 3,
 "name": "example",
 "factors": {
  "status": {
   "ADneg": {"amyloid_positive": false, "params": {"k_A_to_B": 0.1}},
   "ADpos": {"amyloid_positive": true, "params": {"k_A_to_B": 0.2}}
  },
  "treatment": {"Early": {"dose": 10, "delay": 5}, "Late": {"dose": 5, "delay": 10}}
 },
 "subjects": {
  "ADneg": {"kind": "cohort", "levels": {"status": "ADneg"}},
  "ADpos": {"kind": "cohort", "levels": {"status": "ADpos"}}
 },
 "protocols": {
  "dose_at_delay": {
   "events": "Modules.Events:Example_event",
   "solver": "Modules.Solver_settings:solver_settings_Example",
   "observed": "Modules.Observed_species:all_species"
  }
 },
 "simulations": [
  {
   "all": {
    "subjects": ["ADneg", "ADpos"],
    "protocol": "dose_at_delay",
    "factors": {"treatment": "*"}
   }
  }
 ],
 "assays": {
  "B": {
   "observables": {
    "B": {
     "model": {"expr": "predicted_B"},
     "data": {
      "file": "{status}.csv",
      "time": "time",
      "value": ["B1", "B2", "B3"],
      "where": {"Treatment": "{treatment}"}
     }
    }
   }
  }
 }
}
